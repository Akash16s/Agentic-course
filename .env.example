# Copy this file to .env and fill it in.  .env is gitignored.
OPENROUTER_API_KEY=sk-or-v1-...

# The model every example defaults to. Change it any time.
# Cheap + good at tool calling — a sane default to learn on:
AGENT_MODEL=anthropic/claude-haiku-4.5

# A second, stronger model for when you want to compare quality:
AGENT_MODEL_STRONG=anthropic/claude-sonnet-4.5

# Optional: OpenRouter shows these on your activity dashboard
OPENROUTER_APP_TITLE=Agentic Course
OPENROUTER_SITE_URL=http://localhost
